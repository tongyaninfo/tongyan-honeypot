# syntax=docker/dockerfile:1
# 运行时装配镜像（linux/amd64）：只复制已构建的发布产物，不在镜像内执行 npm/dotnet 还原。
# 构建上下文目录需包含：
#   publish/   —— `dotnet publish ... -r linux-x64 -o publish` 的产物，且 frontend/dist 已复制为 publish/wwwroot
#   data/.keep —— 仅用于创建属主为 app 的 /app/data 挂载点
# 标准全量构建见同目录 Dockerfile；本文件用于构建网络受限、需要在本机预构建后再装配的发布路径。
FROM --platform=linux/amd64 mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --chown=app:app publish/ ./
# 绑定数据目录时由宿主机覆盖；不绑定时保证非 root 用户仍可创建 SQLite 文件。
COPY --chown=app:app data/.keep /app/data/.keep
ENV ASPNETCORE_ENVIRONMENT=Production \
    ASPNETCORE_HTTP_PORTS="" \
    Honeypot__DataDirectory=/app/data \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    TZ=Asia/Shanghai
EXPOSE 5080
USER app
ENTRYPOINT ["dotnet", "Honeypot.Api.dll", "--urls", "https://0.0.0.0:5080"]
