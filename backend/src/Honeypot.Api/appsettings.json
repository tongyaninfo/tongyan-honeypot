{
  "Urls": "https://localhost:5080",
  "Honeypot": {
    "LoginLockout": {
      "MaxFailedAttempts": 5,
      "DurationMinutes": 30
    },
    "ConnectionAdmission": {
      "MaxConcurrentConnections": 512,
      "MaxConcurrentConnectionsPerSource": 24,
      "MaxNewConnectionsPerSecond": 120,
      "MaxNewConnectionsPerSourcePerSecond": 12,
      "MaxTrackedSources": 8192,
      "AcceptedEventTimeoutSeconds": 3
    },
    "Events": {
      "QueueCapacity": 256,
      "MemoryEventCapacity": 20000,
      "MemoryRetentionHours": 24,
      "DetailRetentionDays": 30,
      "ThreatRetentionDays": 30,
      "AuditRetentionDays": 90,
      "ReportRetentionDays": 90
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
